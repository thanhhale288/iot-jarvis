UNO_PORT=/dev/cu.usbserial-2110
UNO_BAUD=115200
UNO_OPEN_DELAY=2.0
UNO_PREVENT_RESET=1
# LLM: ollama (mặc định, offline) | deepseek (API — nhanh/thông minh hơn Qwen 7B local)
LLM_PROVIDER=ollama
# Local (M1 16GB): brew services start ollama && ollama pull qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Trường (khi sống lại): https://research.neu.edu.vn/ollama + qwen3:8b
# DeepSeek — dán key từ https://platform.deepseek.com ; bật bằng LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# A3/B5/B7: mock | serial | real (Uno+Otto Serial)
# serial thiếu cổng USB → host soft-fallback mock (vẫn chat/TTS được)
AI_BACKEND=mock
# ESP32: http (Wi‑Fi POST /cmd) | serial (USB otto_motion) | mock | auto
ESP32_TRANSPORT=serial
# Mac hay gặp: ESP32 = …2110, Uno = …2120 (đổi nếu ngược)
ESP32_PORT=/dev/cu.usbserial-2110
UNO_PORT=/dev/cu.usbserial-2120
ESP32_URL=http://192.168.15.165
ESP32_TIMEOUT=20
# Pipeline: led/motion + TTS (0 = chỉ chữ/giọng, không Otto)
OTTO_ACT=1
# Sau khi flash otto_motion (led = chỉ TFT): đặt 1 để gửi led+motion
ESP32_LED_FACE_ONLY=0
# Fast path: lệnh cứng (bật đèn/tưới/…) không qua Ollama/DeepSeek; 0 = luôn LLM
AI_FAST_PATH=0
AI_ENV_CACHE_TTL=2.0
# A4: để trống = giọng Jarvis mặc định; ghi đè style (dùng \\n cho xuống dòng)
# AI_SYSTEM_PROMPT=Bạn là Jarvis. Trả lời mọi chủ đề; tool chỉ khi bàn học.
# A5 STT — ưu tiên đúng tiếng Việt (small + beam 5); base/1 nếu cần tốc độ
STT_MODEL=small
STT_LANGUAGE=vi
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM=5
STT_SILENCE_MS=600
STT_MAX_SECONDS=8
# A6 TTS — full = một lần đọc đúng chuỗi UI; chunk = overlap nhanh hơn
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_MODE=full
