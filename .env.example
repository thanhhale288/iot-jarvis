UNO_PORT=/dev/cu.usbserial-2110
UNO_BAUD=115200
UNO_OPEN_DELAY=2.0
UNO_PREVENT_RESET=1
# Local (M1 16GB): brew services start ollama && ollama pull qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Trường (khi sống lại): https://research.neu.edu.vn/ollama + qwen3:8b
# A3/B4/B5: mock | serial (Uno) | real (Uno Serial + ESP32 Wi‑Fi)
AI_BACKEND=mock
# ESP32 (B1/B4): http = POST /cmd; serial = USB debug khi chưa Wi‑Fi
ESP32_TRANSPORT=serial
ESP32_PORT=/dev/cu.usbserial-2120
ESP32_URL=http://192.168.4.1
ESP32_TIMEOUT=20
# B8: đất khô → bơm (ADC lớn = khô hơn). Hiệu chuẩn: TB(khô,ướt) ≈ 650
SOIL_AUTO_WATER=1
SOIL_DRY_THRESHOLD=650
SOIL_PUMP_SECONDS=3
SOIL_HOST_COOLDOWN_S=3
# B7: pipeline giọng gửi led/motion Otto
VOICE_ACT=1
# Fast path: lệnh cứng (bật đèn/tưới/…) không qua Ollama; 0 = luôn LLM
AI_FAST_PATH=1
AI_ENV_CACHE_TTL=2.0
# A4: để trống = giọng Jarvis mặc định; ghi đè style (dùng \\n cho xuống dòng)
# AI_SYSTEM_PROMPT=Bạn là Jarvis. Trả lời tiếng Việt, tối đa 1 câu.
# A5 STT — ưu tiên đúng tiếng Việt (small + beam 5); base/1 nếu cần tốc độ
STT_MODEL=small
STT_LANGUAGE=vi
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM=5
STT_SILENCE_MS=600
STT_MAX_SECONDS=8
# A6 TTS — full = một lần đọc đúng chuỗi UI; chunk = overlap nhanh hơn
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_MODE=full
SOIL_TRIGGER=wet
